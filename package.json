{
  "name": "ai-assistant-android",
  "version": "1.0.0",
  "description": "Android APK wrapper (Capacitor) for the ai-assistant AI chat app, built via GitHub Actions CI",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "fetch:model": "node scripts/fetch-model.mjs",
    "build:assets": "node scripts/copy-wasm.mjs",
    "pack:template": "node scripts/pack-android-template.mjs",
    "build:js": "esbuild src/app.js --bundle --format=iife --target=es2022 --outfile=www/app.bundle.js",
    "build": "npm run build:assets && npm run pack:template && npm run build:js",
    "prepare:apk": "npm run fetch:model && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sherba31051-max/ai-assistant-android.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/sherba31051-max/ai-assistant-android/issues"
  },
  "homepage": "https://github.com/sherba31051-max/ai-assistant-android#readme",
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@wllama/wllama": "^3.5.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^7.0.2"
  }
}
